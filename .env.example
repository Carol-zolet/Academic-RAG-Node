# Copie este arquivo para .env e preencha com valores reais.
# Nunca commite o .env de verdade (já está no .gitignore).

# --- Google Drive / OAuth (leitura dos materiais das disciplinas) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Modelos de IA ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Login (autenticação única, só para uso pessoal) ---
# APP_USERNAME: usuário de login, texto simples.
APP_USERNAME=
# APP_PASSWORD_HASH: hash bcrypt da senha — NUNCA a senha em texto puro.
# Gere localmente com bcryptjs, ex.: bcrypt.hashSync('sua-senha', 12)
APP_PASSWORD_HASH=
# JWT_SECRET: string aleatória longa usada para assinar/validar o token de sessão.
JWT_SECRET=

# --- Ambiente ---
# NODE_ENV=production faz o cookie de login exigir HTTPS (defina isso no Render).
NODE_ENV=
